# Mancini Tech Solutions — environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# REQUIRED — Google Gemini API key (server-side only; never exposed to the client).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OPTIONAL — Upstash Redis for durable, cross-instance rate limiting.
# If both are set, the chat route uses Upstash. If absent, it falls back to a
# best-effort in-memory limiter (per-instance, resets on cold start).
# Create a free database at https://console.upstash.com/ -> copy the REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
